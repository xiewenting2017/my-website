{
  "name": "oa-ai-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --port 5173\" \"node --watch --env-file=.env server.js\"",
    "dev:web": "vite --port 5173",
    "dev:api": "node --watch --env-file=.env server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "build": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.71.0",
    "openai": "^7.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
